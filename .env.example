# Backend

ENVIRONMENT=development

CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Development automatically accepts localhost and RFC1918 LAN origins.
# Set this only when you need a stricter or custom origin pattern.
CORS_ORIGIN_REGEX=

GROQ_API_KEY=

# One model serves replies and intent classification.
LLM_MODEL=openai/gpt-oss-120b
LLM_CLASSIFIER_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
# gpt-oss reasoning tokens count against max_tokens; low keeps replies whole.
LLM_REASONING_EFFORT=low

OPENAI_API_KEY=

QDRANT_URL=

QDRANT_API_KEY=

UPSTASH_REDIS_URL=

UPSTASH_REDIS_TOKEN=

UPSTASH_REDIS_REST_URL=

UPSTASH_REDIS_REST_TOKEN=

LANGSMITH_API_KEY=

SENTRY_DSN=

# Emotion analysis is parked for the telecalling build. Set to true to load
# the model again; nothing loads or waits while this is false.
VOICE_ENABLE_EMOTION=false

VOICE_ALLOW_WHISPER_FALLBACK=true

# silero or energy
VOICE_VAD_PROVIDER=silero
EMOTION_DOUBT_THRESHOLD=0.70

EMOTION2VEC_MODEL=iic/emotion2vec_plus_base

EMOTION2VEC_HUB=hf

EMOTION_WAIT_TIMEOUT_SECONDS=0.30

RAG_RELEVANCE_THRESHOLD=0.55

CARTESIA_API_KEY=

CARTESIA_VOICE_ID=

# sonic-3.6 is the current model; it speaks hi, kn and en natively.
CARTESIA_MODEL=sonic-3.6

# Used when the session language is still "auto".
VOICE_TTS_LANGUAGE=en-IN

# Voice transcription

VOICE_STT_PROVIDER=sarvam

# auto | hi-IN | kn-IN | en-IN
VOICE_DEFAULT_LANGUAGE=auto

# Phase 3: ask the merchant which language to use, then lock it for the call.
# Set to false to keep detect-as-you-go behaviour.
VOICE_ASK_LANGUAGE=true

# Language to use when two answers do not resolve a choice (brief says English).
VOICE_LANGUAGE_ON_FAILURE=en-IN

# Where pre-rendered fixed phrases are cached, relative to backend/.
# Empty uses backend/.cache/voice_phrases. The directory is git-ignored.
VOICE_PHRASE_CACHE_DIR=

# Sarvam realtime streaming STT (primary).
SARVAM_API_KEY=

SARVAM_STT_MODEL=saaras:v3-realtime

# fast | balanced | simulated
SARVAM_STT_STREAM_TYPE=fast

SARVAM_STT_ENDPOINTING=vad

SARVAM_STT_SILENCE_MS=500

SARVAM_STT_MIN_SPEECH_MS=250

SARVAM_STT_THRESHOLD=0.3

SARVAM_STT_PROMPT=Paytm merchant payments, QR codes, settlements, refunds and soundbox

VOICE_ALLOW_WHISPER_FALLBACK=true

# Deepgram is the first backup, then local Whisper.
VOICE_ALLOW_DEEPGRAM_FALLBACK=true

DEEPGRAM_API_KEY=

DEEPGRAM_MODEL=nova-3

DEEPGRAM_LANGUAGE=en-US

DEEPGRAM_ENDPOINTING_MS=300

DEEPGRAM_UTTERANCE_END_MS=1000

DEEPGRAM_KEYWORDS=Paytm:3

VOICE_MAX_TOKENS=320

# Spoken reply budget: aim for three sentences, allow a fourth when it is a
# question, and never exceed five. Over-budget replies close with a short
# "would you like to know more?" offer.
VOICE_REPLY_SOFT_SENTENCES=3
VOICE_REPLY_MAX_SENTENCES=5

VOICE_INTERRUPTION_CONFIRM_TIMEOUT_SECONDS=2.5

# Frontend

NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_DEPLOYMENT_PROFILE=local
